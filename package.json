{
  "name": "@crewbit/cli",
  "version": "0.1.1",
  "description": "The Crewbit runner: connects, executes a Job with your own Claude Code, and reports back",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:macos-arm64": "bun build --compile --target=bun-darwin-arm64 --outfile=bin/crewbit-macos-arm64 src/cli.ts",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 --outfile=bin/crewbit-linux-x64 src/cli.ts",
    "release": "bun tools/release/prepare.ts"
  },
  "dependencies": {
    "@crewbit/protocol": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
